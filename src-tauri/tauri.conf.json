{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WallFlow",
  "version": "0.1.0",
  "identifier": "com.wallflow.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "WallFlow",
        "width": 960,
        "height": 680,
        "minWidth": 780,
        "minHeight": 560,
        "resizable": true,
        "visible": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPLOCALDATA/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "WallFlow",
    "copyright": "WallFlow",
    "category": "Utility",
    "shortDescription": "Lightweight daily wallpaper manager",
    "longDescription": "WallFlow changes your Windows desktop wallpaper on a schedule, uses very little bandwidth, and keeps working offline.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": ["resources/default-wallpaper.png"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false,
        "languages": ["English"],
        "startMenuFolder": "WallFlow"
      }
    }
  }
}
